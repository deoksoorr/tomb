# 「한때는...」 web(Vercel) 환경변수
# 로컬에서는 아무것도 설정하지 않아도 돈다: MemoryStore(목업 묘비) + 메모리 레이트리밋 + 로컬 업로드.
# 운영(NODE_ENV=production)에서는 아래 "필수" 값이 없으면 해당 API가 명확한 에러 메시지와 함께 실패한다.

# ── 필수 시크릿 (운영) ──
# 아래 세 값은 모두 32자 이상 무작위 문자열로 만든다. 생성 예: openssl rand -base64 32

# 방문자 쿠키(vid) HMAC 서명 키. 레이트리밋·신고 집계용 IP 해시의 소금으로도 쓴다.
SESSION_SECRET=
# 입장 토큰 HMAC 서명 키 (32자 이상). Cloudflare Worker(apps/realtime)의 JOIN_SECRET과 반드시 같은 값.
#   로컬 기본값: dev-join-secret-change-me (realtime 개발 기본값과 같음)
JOIN_SECRET=
# 관리자 API(/api/admin/*) 키 (32자 이상). 헤더 `x-admin-key: <키>` 또는 `Authorization: Bearer <키>`.
#   틀린 키는 IP당 분당 10회까지만 받고, 넘으면 잠시 429로 막는다.
#   로컬 기본값: dev-admin
ADMIN_KEY=
# 관리자 화면(/admin)과 API(/api/admin/*)에 들어올 수 있는 IP. 쉼표로 구분, IPv4/IPv6, CIDR 가능.
#   예) 58.233.55.38  또는  58.233.55.38, 10.0.0.0/8, 2001:db8::/32
#   목록 밖에서는 일반 404로 보인다. 운영에서 비어 있으면 아무도 못 들어오고,
#   로컬에서 비어 있으면 127.0.0.1·::1만 허용한다. IP가 바뀌면 여기를 고치고 재배포한다.
ADMIN_ALLOWED_IPS=

# ── 실시간 서버 ──
# (운영 필수) 브라우저가 접속할 Worker 주소(https). wss 주소는 여기서 자동으로 만든다. 로컬 기본값: http://localhost:8787
#   운영에서 비어 있으면 /api/join이 500으로 실패한다(로그에 원인).
NEXT_PUBLIC_REALTIME_URL=
# (선택) 서버가 로비를 조회할 때만 쓰는 주소. 비우면 NEXT_PUBLIC_REALTIME_URL을 쓴다.
REALTIME_INTERNAL_URL=

# ── 배경음악 ──
# (선택) 곡 파일을 받을 주소 (Cloudflare R2 버킷 tomb-bgm, 예: https://bgm.myproject.rip). /bgm/lofi/a.mp3 → <이 주소>/lofi/a.mp3
#   비우면 지금처럼 public/bgm 에서 받는다. 빌드 때 박히므로 바꾸면 재배포.
# 운영·테스트 서버 값: https://tomb-bgm.daveki.workers.dev (apps/bgm-cdn 워커, R2 tomb-bgm)
NEXT_PUBLIC_BGM_BASE=

# ── Upstash Redis (Vercel Marketplace 연동 시 자동 주입) ──
# 둘 중 한 쌍만 있으면 된다. 없으면 로컬에서는 MemoryStore를 쓰고, 운영에서는 에러.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Blob (Storage에서 Public 스토어를 만들어 연결하면 자동 주입) ──
# 연결 방식은 둘 중 하나. 둘 다 없으면 업로드가 로컬 대체 경로(/api/upload/local, 개발 전용)로 바뀐다.
# 묘비 이미지는 이 스토어 주소(<storeId>.public.blob.vercel-storage.com/graves/...)만 허용한다.
#
# 1) OIDC 방식 (Vercel의 현재 기본): 스토어 id와 웹훅 공개키만 주입되고, 인증은 런타임에 Vercel이 주는
#    OIDC 토큰(VERCEL_OIDC_TOKEN)으로 한다. 로컬에서 이 방식으로 Blob에 올리려면 `vercel env pull`로
#    VERCEL_OIDC_TOKEN(12시간 유효)까지 받아야 한다. 아니면 BLOB_STORE_ID를 비워 로컬 업로드를 쓴다.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# 2) 읽기쓰기 토큰 방식: `vercel_blob_rw_<storeId>_...`. 있으면 OIDC보다 우선한다.
BLOB_READ_WRITE_TOKEN=

# ── 문의하기 → GitHub 이슈 (선택) ──
# 둘 다 있어야 "문의하기"가 켜진다. 없으면 문의 화면에 "준비 중"이 뜬다.
# GITHUB_TOKEN: fine-grained personal access token. 아래 저장소 하나만 고르고 권한은 Issues: Read and write만 준다.
# GITHUB_INQUIRY_REPO: owner/repo (예: myname/hanttae-inquiries)
#   ⚠ 공개 저장소면 문의 내용(연락처 포함)이 누구에게나 공개된다. 비공개 저장소를 쓰자.
#     서버가 저장소 공개 여부를 조회해서, 공개면 문의 화면이 그 사실을 안내한다.
GITHUB_TOKEN=
GITHUB_INQUIRY_REPO=

# ── 계정·포인트·상점 (v2) ──
# 따로 설정할 값은 없다. 계정·가방·포인트는 위 Upstash Redis에, 폭죽·착용 증서는 JOIN_SECRET으로 서명한다.
# 새 버전 안내용 배포 식별자는 Vercel이 주는 VERCEL_DEPLOYMENT_ID / VERCEL_GIT_COMMIT_SHA를 쓴다 (로컬은 "dev").

# ── 로컬 개발 ──
# MemoryStore가 처음 뜰 때 심는 목업 묘비 수 (기본 30, 성능 확인용으로 500 등)
MOCK_GRAVES=30
