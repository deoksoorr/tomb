# 「한때는...」 web(Vercel) 환경변수
# 로컬에서는 아무것도 설정하지 않아도 돈다: MemoryStore(목업 묘비) + 메모리 레이트리밋 + 로컬 업로드.
# 운영(NODE_ENV=production)에서는 아래 "필수" 값이 없으면 해당 API가 명확한 에러 메시지와 함께 실패한다.

# ── 필수 시크릿 (운영) ──
# 아래 세 값은 모두 32자 이상 무작위 문자열로 만든다. 생성 예: openssl rand -base64 32

# 방문자 쿠키(vid) HMAC 서명 키. 레이트리밋·신고 집계용 IP 해시의 소금으로도 쓴다.
SESSION_SECRET=
# 입장 토큰 HMAC 서명 키 (32자 이상). Cloudflare Worker(apps/realtime)의 JOIN_SECRET과 반드시 같은 값.
#   로컬 기본값: dev-join-secret-change-me (realtime 개발 기본값과 같음)
JOIN_SECRET=
# 관리자 API(/api/admin/*) 키 (32자 이상). 헤더 `x-admin-key: <키>` 또는 `Authorization: Bearer <키>`.
#   틀린 키는 IP당 분당 10회까지만 받고, 넘으면 잠시 429로 막는다.
#   로컬 기본값: dev-admin
ADMIN_KEY=

# ── 실시간 서버 ──
# (운영 필수) 브라우저가 접속할 Worker 주소(https). wss 주소는 여기서 자동으로 만든다. 로컬 기본값: http://localhost:8787
#   운영에서 비어 있으면 /api/join이 500으로 실패한다(로그에 원인).
NEXT_PUBLIC_REALTIME_URL=
# (선택) 서버가 로비를 조회할 때만 쓰는 주소. 비우면 NEXT_PUBLIC_REALTIME_URL을 쓴다.
REALTIME_INTERNAL_URL=

# ── Upstash Redis (Vercel Marketplace 연동 시 자동 주입) ──
# 둘 중 한 쌍만 있으면 된다. 없으면 로컬에서는 MemoryStore를 쓰고, 운영에서는 에러.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Blob (Storage에서 Blob 스토어를 만들면 자동 주입) ──
# 없으면 업로드가 로컬 대체 경로(/api/upload/local, 개발 전용)로 바뀐다.
# 묘비 이미지는 이 토큰의 스토어 주소(<storeId>.public.blob.vercel-storage.com/graves/...)만 허용한다.
BLOB_READ_WRITE_TOKEN=

# ── 로컬 개발 ──
# MemoryStore가 처음 뜰 때 심는 목업 묘비 수 (기본 30, 성능 확인용으로 500 등)
MOCK_GRAVES=30
